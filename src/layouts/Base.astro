---
import '../styles/global.css';
import { PREVIEW, SITE_NAME } from '../lib/site';
interface Props { title: string; description: string; jsonLd?: object; noindex?: boolean }
const { title, description, jsonLd, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {PREVIEW || noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=IBM+Plex+Mono:wght@500;600&family=IBM+Plex+Sans:wght@400;500;600&display=swap" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    {PREVIEW && <div class="preview-bar">Preview build · hidden from search engines until launch</div>}
    <header class="site-header">
      <div class="wrap header-row">
        <a class="brand" href="/">
          <img src="/favicon.svg" alt="" width="26" height="26" />
          <span>{SITE_NAME}</span>
        </a>
        <nav aria-label="Main">
          <a href="/makes/">Makes</a>
          <a href="/lights/">All symbols</a>
          <a href="/about/">About</a>
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-row">
        <p class="small muted" style="margin:0;max-width:60ch">Warning light meanings from official owner's manuals, with symbols drawn by us. As an Amazon Associate we earn from qualifying purchases.</p>
        <nav aria-label="Footer">
          <a href="/about/">About</a>
          <a href="/sources/">Sources and method</a>
          <a href="/privacy/">Privacy</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
