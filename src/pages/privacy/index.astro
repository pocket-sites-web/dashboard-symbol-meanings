---
import Base from '../../layouts/Base.astro';
import { SITE_NAME } from '../../lib/site';
---
<Base title="Privacy Policy" description={`How ${SITE_NAME} handles your data.`}>
  <section class="prose">
    <h1>Privacy</h1>
    <p>We don't ask you to sign up and we don't collect personal details. We may use analytics to count page views, and some links go to Amazon, where we earn a commission on qualifying purchases at no cost to you.</p>
  </section>
</Base>
